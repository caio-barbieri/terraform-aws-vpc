{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/15cc8f3cd18c4272925ce1c7053268eedff1ea0a/schemas/agent-v1.json",
  "name": "terraform-aws-vpc",
  "description": "Repository-scoped agent for safely maintaining the Terraform AWS VPC module",
  "prompt": "file://../../AGENTS.md",
  "mcpServers": {
    "awslabs.aws-documentation-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@1.1.30"],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000,
      "disabled": false
    },
    "aws-knowledge-mcp-server": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws",
      "command": "",
      "disabled": false
    },
    "awslabs.terraform-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.terraform-mcp-server@1.0.18"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000,
      "disabled": false
    }
  },
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking",
    "todo_list",
    "@awslabs.aws-documentation-mcp-server",
    "@aws-knowledge-mcp-server",
    "@awslabs.terraform-mcp-server"
  ],
  "allowedTools": [
    "fs_read",
    "thinking",
    "todo_list",
    "@awslabs.aws-documentation-mcp-server",
    "@aws-knowledge-mcp-server"
  ],
  "resources": [
    "file://../../README.md",
    "file://../../CONTRIBUTING.md",
    "file://../../SECURITY.md",
    "file://../../docs/*.md",
    "file://../../variables.tf",
    "file://../../outputs.tf",
    "file://../../testing/*.tftest.hcl"
  ],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        ".*terraform.*(apply|destroy|import|taint|untaint|force-unlock).*"
      ]
    }
  },
  "useLegacyMcpJson": false,
  "model": null
}
